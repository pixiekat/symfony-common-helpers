{% extends '@PixiekatSymfonyHelpers/admin_layout.html.twig' %}

{% block title %}{{ 'Edit Item: %item%'|trans({'%item%': item.name}) }}{% endblock %}

{% block admin_content %}
  <div class="container">
    <div class="row">
      <div class="col">
        <h1>{{ 'Edit Item: %item%'|trans({'%item%': item.label ?? item.name}) }}</h1>
        <p class="text-muted">{{ 'In block %block%'|trans({'%block%': block.label ?? block.name}) }}</p>
      </div>
    </div>
    <div class="row">
      <div class="col text-end mb-3">
        <a class="btn btn-secondary" href="{{ path('pixiekat_symfony_helpers_block_item_list', { block: block.id }) }}">{{ 'Back to Items'|trans }}</a>
      </div>
    </div>
    <div class="row">
      <div class="col">
        {{ form(form) }}
      </div>
    </div>
  </div>
{% endblock %}
