{% extends admin_layout %}

{% block admin_page_title %}{{ 'Add Item to %block%'|trans({'%block%': block.name}) }}{% endblock %}

{% block content %}
  <div class="container">
    <div class="row">
      <div class="col">
        <h1>{{ 'Add Item to %block%'|trans({'%block%': block.label ?? block.name}) }}</h1>
      </div>
    </div>
    <div class="row">
      <div class="col text-end mb-3">
        <a class="btn btn-secondary" href="{{ path('pixiekat_symfony_helpers_block_item_list', { block: block.id }) }}">{{ 'Back to Items'|trans }}</a>
      </div>
    </div>
    <div class="row">
      <div class="col">
        {{ form(form) }}
      </div>
    </div>
  </div>
{% endblock %}
