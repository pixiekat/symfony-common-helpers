{% extends admin_layout %}

{% block admin_page_title %}{{ 'bans.add.title'|trans }}{% endblock %}

{% block content %}
  <div class="container">
    <div class="row">
      <div class="col">
        <h1>{{ 'bans.add.title'|trans }}</h1>
      </div>
    </div>
    <div class="row">
      <div class="col text-end mb-3">
        <a class="btn btn-secondary" href="{{ path('pixiekat_symfony_helpers_ban_list') }}">{{ 'back_to_list'|trans }}</a>
      </div>
    </div>
    <div class="row">
      <div class="col">
        {{ form_start(form) }}
          {{ form(form) }}
        {{ form_end(form) }}
      </div>
    </div>
  </div>
{% endblock %}
