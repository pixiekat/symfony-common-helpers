{% extends '@PixiekatSymfonyHelpers/admin_layout.html.twig' %}

{% block title %}{{ parent() }} - {{ 'bans.edit.title'|trans({'%ip_address%': ban.getIpAddress }) }}{% endblock %}

{% block body %}
  <div class="container">
    <div class="row">
      <div class="col">
        <h1>{{ 'bans.edit.title'|trans({'%ip_address%': ban.getIpAddress }) }}</h1>
      </div>
    </div>
    <div class="row">
      <div class="col text-end mb-3">
        <a class="btn btn-secondary" href="{{ path('pixiekat_symfony_helpers_ban_list') }}">{{ 'back_to_list'|trans }}</a>
      </div>
    </div>
    <div class="row">
      <div class="col">
        {{ form_start(form) }}
          {{ form(form) }}
        {{ form_end(form) }}
      </div>
    </div>
  </div>
{% endblock %}
